{
    "name": "drupal/localgov_page",
    "description": "A page content type for LocalGov Drupal that allows the building of rich content using Paragraphs.",
    "type": "drupal-module",
    "homepage": "https://drupal.org/project/localgov_page",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
        "drupal/localgov_core": "^2.0 || ^3.0",
        "drupal/localgov_paragraphs": "^2.0"
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {}
    }
}
