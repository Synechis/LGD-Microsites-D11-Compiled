{
    "name": "drupal/localgov_microsites",
    "description": "LocalGov Drupal Microsites distribution",
    "type": "drupal-profile",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/localgov_microsites",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "drupal/admin_toolbar": "^3.1",
        "drupal/autosave_form": "^1.3",
        "drupal/core": "^11.3",
        "drupal/default_content": "^2.0@alpha",
        "drupal/domain_path": "^1.6",
        "drupal/gin": "^3.0 || ^4.0 || ^5.0",
        "drupal/gin_login": "^2.0.3",
        "drupal/gin_toolbar": "^1.0 || ^2.0 || ^3.0",
        "drupal/metatag": "^2.0.2",
        "drupal/redirect": "^1.9",
        "drupal/responsive_preview": "^2.1",
        "drupal/localgov_blogs": "^1.1",
        "drupal/localgov_core": "^2.12 || ^3.0",
        "drupal/localgov_directories": "^3.1",
        "drupal/localgov_events": "^3.0",
        "drupal/localgov_guides": "^2.1",
        "drupal/localgov_live_preview": "^1.1@beta",
        "drupal/localgov_microsites_group": "^4.0",
        "drupal/localgov_microsites_base": "^2.0 || ^3.0",
        "drupal/localgov_microsites_colour_picker_fields": "^1.0.0-beta1",
        "drupal/localgov_news": "^2.3",
        "drupal/localgov_page": "^1.2",
        "drupal/localgov_claro": "^2.1.0",
        "drupal/require_login": "^3.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/domain_path": {
                "https://github.com/localgovdrupal/localgov_microsites/pull/175#issuecomment-1172879196": "https://raw.githubusercontent.com/localgovdrupal/localgov_microsites/995261d0909065e3124fba3fc0dce3e823aefa1d/patches/domain_path.146-url-aliases.patch"
            }
        }
    }
}
